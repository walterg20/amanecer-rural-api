# ── Base de datos ──
DB_HOST=localhost
DB_PORT=5433
DB_NAME=amanecer_rural
DB_USER=ar_user
DB_PASSWORD=change-this-in-production

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_TTL=300

# ── JWT ──
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d

# ── API ──
API_PORT=3000
# CORS — en producción, lista de orígenes separada por comas
CORS_ORIGIN=*
NODE_ENV=development

# ── Mercado Pago ──
MP_ACCESS_TOKEN=TEST-xxxxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxxxx
# Webhook secret desde el panel de MercadoPago -> Notificaciones -> Webhooks
MP_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:4200
API_URL=http://localhost:3000

# ── Weather API ──
WEATHER_API_KEY=your_weather_api_key_here

# ── SMTP ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@amanecerrural.com
