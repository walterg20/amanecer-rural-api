{
  "info": {
    "name": "Amanecer Rural API",
    "description": "Colección de endpoints para la API de Amanecer Rural.\n\n## Configuración inicial\n1. La variable `baseUrl` apunta a `http://localhost:3000/api/v1` por defecto.\n2. Usa el endpoint **Login** o **Register** para autenticarte — el token se guarda automáticamente.\n3. Los endpoints protegidos usan `{{accessToken}}` en el header `Authorization`.\n\n## Roles disponibles\n- `superadmin` — acceso total\n- `admin` — gestión de usuarios y contenido\n- `editor` — gestión de contenido\n- `provider` — proveedores (futuro)\n- `user` — usuario básico",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is ok', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('ok');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Verifica que el servidor esté funcionando correctamente."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"status\": \"ok\",\n  \"timestamp\": \"2025-07-17T12:00:00.000Z\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@ejemplo.com\",\n  \"password\": \"contraseñaSegura123\",\n  \"name\": \"Juan Pérez\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registra un nuevo usuario. El token se guarda automáticamente en las variables de colección."
          },
          "response": [
            {
              "name": "Created",
              "status": "Created",
              "code": 201,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"user\": {\n    \"id\": 1,\n    \"email\": \"usuario@ejemplo.com\",\n    \"name\": \"Juan Pérez\",\n    \"role\": \"user\"\n  },\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIs...\",\n  \"refreshToken\": \"eyJhbGciOiJIUzI1NiIs...\"\n}"
            }
          ]
        },
        {
          "name": "Iniciar sesión",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@ejemplo.com\",\n  \"password\": \"contraseñaSegura123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Inicia sesión con credenciales. El token se guarda automáticamente en las variables de colección."
          },
          "response": [
            {
              "name": "Success",
              "status": "Created",
              "code": 201,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"user\": {\n    \"id\": 1,\n    \"email\": \"usuario@ejemplo.com\",\n    \"name\": \"Juan Pérez\",\n    \"role\": \"user\"\n  },\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIs...\",\n  \"refreshToken\": \"eyJhbGciOiJIUzI1NiIs...\"\n}"
            }
          ]
        },
        {
          "name": "Renovar tokens",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Renueva el access token usando el refresh token."
          },
          "response": [
            {
              "name": "Success",
              "status": "Created",
              "code": 201,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"data\": {\n    \"accessToken\": \"eyJhbGciOiJIUzI1NiIs...\",\n    \"refreshToken\": \"eyJhbGciOiJIUzI1NiIs...\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Obtener perfil",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Obtiene el perfil del usuario autenticado."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"data\": {\n    \"id\": 1,\n    \"email\": \"usuario@ejemplo.com\",\n    \"name\": \"Juan Pérez\",\n    \"role\": \"user\",\n    \"avatar\": null\n  }\n}"
            }
          ]
        },
        {
          "name": "Actualizar perfil",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Pérez Actualizado\",\n  \"avatar\": \"https://ejemplo.com/avatar.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Actualiza el nombre y/o avatar del perfil del usuario autenticado."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"data\": {\n    \"id\": 1,\n    \"email\": \"usuario@ejemplo.com\",\n    \"name\": \"Juan Pérez Actualizado\",\n    \"role\": \"user\",\n    \"avatar\": \"https://ejemplo.com/avatar.jpg\"\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Admin / Usuarios",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"]
            },
            "description": "Lista todos los usuarios registrados. Requiere rol `superadmin` o `admin`."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"data\": [\n    {\n      \"id\": 1,\n      \"email\": \"admin@ejemplo.com\",\n      \"name\": \"Admin\",\n      \"role\": {\n        \"id\": 1,\n        \"name\": \"Superadmin\",\n        \"slug\": \"superadmin\"\n      },\n      \"active\": true\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Cambiar rol de usuario",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"editor\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/1/role",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users", ":id", "role"],
              "variable": [
                { "key": "id", "value": "1", "description": "ID del usuario a modificar" }
              ]
            },
            "description": "Cambia el rol de un usuario. Roles disponibles: `superadmin`, `admin`, `editor`, `provider`, `user`."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"data\": {\n    \"id\": 1,\n    \"email\": \"usuario@ejemplo.com\",\n    \"name\": \"Juan Pérez\",\n    \"role\": {\n      \"id\": 3,\n      \"name\": \"Editor\",\n      \"slug\": \"editor\"\n    }\n  }\n}"
            }
          ]
        }
      ]
    },
    {
